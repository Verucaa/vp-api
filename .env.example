# Per-client-IP fixed window (60 seconds), shared across API endpoints per process/instance.
# The configured maximum can be lowered, but is hard-capped at 100.
RATE_LIMIT_MAX=100

# Optional exact origins allowed to call this API from another browser origin.
# Leave unset for same-origin UI only.
# CORS_ORIGINS=https://your-frontend.example

# Set only when the app is behind a trusted reverse proxy; Vercel defaults to one proxy hop.
# TRUST_PROXY=1
